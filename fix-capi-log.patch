diff --git a/app/api/capi/route.ts b/app/api/capi/route.ts
index c33b863..dbd57dc 100644
--- a/app/api/capi/route.ts
+++ b/app/api/capi/route.ts
@@ -10,7 +10,7 @@ const supabase = createClient(
